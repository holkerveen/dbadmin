# Copy to .env for the main `docker-compose.yml` dev stack.
# Test stacks (docker-compose.test-*.yml) use hardcoded throwaway
# credentials and do not read this file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dbadmin

# Host ports published by docker-compose.yml
DB_HOST_PORT=55432
APP_HOST_PORT=8080

DB_ADMIN_PORT=80
